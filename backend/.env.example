# --- Data backend ---
# memory (default, no GCP needed) | bigquery
DATA_BACKEND=memory
GCP_PROJECT_ID=
BIGQUERY_DATASET=razorpay_pulse

# --- Pub/Sub ---
PUBSUB_ENABLED=false
PUBSUB_TOPIC=payment-telemetry

# --- AI provider ---
# mock (default, no key needed) | vertex
AI_PROVIDER=mock
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- Razorpay TEST/SANDBOX credentials only. Never production keys. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
